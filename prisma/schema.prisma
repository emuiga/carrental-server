generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Connection URL is configured via prisma.config.ts (Prisma 7+)
}

// ─── Enums ──────────────────────────────────────────────────────────────────

enum SubscriptionStatus {
  trial
  active
  inactive
}

enum UserRole {
  superadmin
  admin
  manager
  staff
}

enum CustomerType {
  local
  tourist
  expat
}

enum VehicleCategory {
  small
  sedan
  suv
  van
  seven_seater
}

enum VehicleStatus {
  available
  rented
  maintenance
}

enum BookingStatus {
  pending
  active
  completed
  cancelled
}

enum PaymentStatus {
  unpaid
  partial
  paid
}

enum PaymentMethod {
  mpesa
  cash
  card
  bank
}

// ─── Models ─────────────────────────────────────────────────────────────────

model Company {
  id                 String             @id @default(uuid())
  name               String             @db.VarChar(255)
  slug               String             @unique @db.VarChar(100)
  logoUrl            String?            @map("logo_url")
  primaryColor       String?            @map("primary_color") @db.VarChar(7)
  /// JSON object of feature flags: { sms: bool, mpesa: bool, portal: bool, reports: bool }
  enabledFeatures    Json               @default("{}") @map("enabled_features")
  subscriptionStatus SubscriptionStatus @default(trial) @map("subscription_status")
  phone              String?            @db.VarChar(20)
  email              String?            @db.VarChar(255)
  address            String?
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  users     User[]
  customers Customer[]
  vehicles  Vehicle[]
  bookings  Booking[]
  payments  Payment[]

  @@map("companies")
}

model User {
  id           String   @id @default(uuid())
  /// null for superadmin users — they belong to no company
  companyId    String?  @map("company_id")
  email        String   @db.VarChar(255)
  passwordHash String   @map("password_hash")
  role         UserRole @default(staff)
  firstName    String?  @map("first_name") @db.VarChar(100)
  lastName     String?  @map("last_name") @db.VarChar(100)
  isActive         Boolean  @default(true) @map("is_active")
  twoFactorSecret  String?  @map("two_factor_secret")
  twoFactorEnabled Boolean  @default(false) @map("two_factor_enabled")
  /// OAuth provider (e.g. "google") — null for credentials users
  oauthProvider    String?  @map("oauth_provider")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  company Company? @relation(fields: [companyId], references: [id])

  /// Same email can exist in different companies but not within the same one.
  /// Superadmins have companyId = null; uniqueness enforced at app level.
  @@unique([email, companyId])
  @@index([companyId])
  @@map("users")
}

model Customer {
  id              String       @id @default(uuid())
  companyId       String       @map("company_id")
  fullName        String       @map("full_name") @db.VarChar(255)
  idNumber        String       @map("id_number") @db.VarChar(50)
  drivingLicense  String?      @map("driving_license") @db.VarChar(50)
  licenseExpiry   DateTime?    @map("license_expiry")
  phone           String?      @db.VarChar(20)
  email           String?      @db.VarChar(255)
  address         String?
  nextOfKinName   String?      @map("next_of_kin_name") @db.VarChar(255)
  nextOfKinPhone  String?      @map("next_of_kin_phone") @db.VarChar(20)
  employerDetails String?      @map("employer_details")
  customerType    CustomerType @default(local) @map("customer_type")
  isActive        Boolean      @default(true) @map("is_active")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  company  Company   @relation(fields: [companyId], references: [id])
  bookings Booking[]

  @@index([companyId])
  @@index([companyId, idNumber])
  @@map("customers")
}

model Vehicle {
  id                 String          @id @default(uuid())
  companyId          String          @map("company_id")
  registrationNumber String          @map("registration_number") @db.VarChar(20)
  make               String          @db.VarChar(100)
  model              String          @db.VarChar(100)
  year               Int
  category           VehicleCategory @default(sedan)
  dailyRate          Decimal         @map("daily_rate") @db.Decimal(10, 2)
  status             VehicleStatus   @default(available)
  photoUrls          Json            @default("[]") @map("photo_urls")
  mileage            Int?
  color              String?         @db.VarChar(50)
  fuelType           String?         @map("fuel_type") @db.VarChar(20)
  transmission       String?         @db.VarChar(20)
  seats              Int?
  notes              String?
  isActive           Boolean         @default(true) @map("is_active")
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")

  company  Company   @relation(fields: [companyId], references: [id])
  bookings Booking[]

  @@unique([registrationNumber, companyId])
  @@index([companyId])
  @@index([companyId, status])
  @@map("vehicles")
}

model Booking {
  id             String        @id @default(uuid())
  companyId      String        @map("company_id")
  vehicleId      String        @map("vehicle_id")
  customerId     String        @map("customer_id")
  startDate      DateTime      @map("start_date")
  endDate        DateTime      @map("end_date")
  dailyRate      Decimal       @map("daily_rate") @db.Decimal(10, 2)
  totalAmount    Decimal       @map("total_amount") @db.Decimal(10, 2)
  depositPaid    Decimal       @default(0) @map("deposit_paid") @db.Decimal(10, 2)
  status         BookingStatus @default(pending)
  paymentStatus  PaymentStatus @default(unpaid) @map("payment_status")
  notes          String?
  pickupLocation String?       @map("pickup_location")
  returnLocation String?       @map("return_location")
  startMileage   Int?          @map("start_mileage")
  endMileage     Int?          @map("end_mileage")
  /// ID of the staff member who created the booking
  createdBy      String?       @map("created_by")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  company  Company   @relation(fields: [companyId], references: [id])
  vehicle  Vehicle   @relation(fields: [vehicleId], references: [id])
  customer Customer  @relation(fields: [customerId], references: [id])
  payments Payment[]

  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, vehicleId])
  @@index([companyId, customerId])
  @@map("bookings")
}

model Payment {
  id             String        @id @default(uuid())
  /// Redundant FK for security: staff can only query payments within their company
  companyId      String        @map("company_id")
  bookingId      String        @map("booking_id")
  amount         Decimal       @db.Decimal(10, 2)
  paymentMethod  PaymentMethod @map("payment_method")
  transactionRef String?       @map("transaction_ref") @db.VarChar(100)
  paymentDate    DateTime      @map("payment_date")
  notes          String?
  /// ID of the staff member who recorded the payment
  recordedBy     String?       @map("recorded_by")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id])
  booking Booking @relation(fields: [bookingId], references: [id])

  @@index([companyId])
  @@index([companyId, bookingId])
  @@map("payments")
}
